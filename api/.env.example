# EduGenius 环境变量配置示例
# 复制此文件为 .env 并填入真实的 API 密钥

# ========== 安全配置（重要！）==========
# JWT Secret Key - 生产环境必须设置为强随机密钥！
# ⚠️ 不要使用默认值，否则会有严重安全风险！
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars!

# Token 有效期（分钟），默认 120 分钟（2 小时）
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ========== API 密钥 ==========
# DashScope (通义千问) API 密钥
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# OpenAI API 密钥（备用，可选）
OPENAI_API_KEY=your-openai-api-key-here

# ========== 数据库配置 ==========
# SQLite 数据库路径
DATABASE_URL=sqlite+aiosqlite:///./edugenius.db

# ========== Redis 缓存配置 ==========
# Redis 连接配置（可选，如果不设置则禁用缓存）
# Redis 主机地址
REDIS_HOST=localhost
# Redis 端口
REDIS_PORT=6379
# Redis 数据库编号（0-15）
REDIS_DB=0
# Redis 密码（如果设置了密码）
# REDIS_PASSWORD=your-redis-password
# Redis 连接 URL（完整格式，优先级高于上面的单独配置）
# REDIS_URL=redis://:password@localhost:6379/0
# 是否启用 Redis 缓存（true/false）
REDIS_ENABLED=true

# ========== ChromaDB 配置 ==========
# ChromaDB 持久化目录
CHROMA_PERSIST_DIR=./chroma_db

# ========== 应用配置 ==========
DEBUG=False
DEFAULT_MODEL=qwen-max
FALLBACK_MODEL=qwen-plus

# 日志配置
LOG_LEVEL=INFO
ENABLE_JSON_LOGS=false

# CORS 配置（多个源用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ========== 教学配置 ==========
MAX_QUESTIONS_PER_SESSION=5
DEFAULT_STUDENT_LEVEL=3

# ========== 文档处理配置 ==========
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ========== OCR 配置 ==========
# OCR 文本比例阈值（0-1，默认 0.1 表示 10%）
# 当 PDF 文本页占比 >= 此值时使用快速路径，否则使用 OCR 路径
OCR_TEXT_RATIO_THRESHOLD=0.1

# OCR 置信度阈值（0-1，默认 0.6 表示 60%）
# 当 OCR 识别置信度 < 此值时，会警告用户识别质量较低
OCR_CONFIDENCE_THRESHOLD=0.6

# OCR 并发控制（最多同时处理的 OCR 任务数）
# 防止多个用户同时上传扫描版 PDF 导致服务器内存溢出
OCR_MAX_CONCURRENT=2

# ========== 邮件配置 ==========
# SMTP 服务器配置（用于密码重置等功能）
# SMTP 主机地址
SMTP_HOST=smtp.gmail.com
# SMTP 端口
SMTP_PORT=587
# SMTP 用户名（通常是邮箱地址）
SMTP_USER=your-email@example.com
# SMTP 密码（可能是邮箱密码或应用专用密码）
# 注意：Gmail 需要使用应用专用密码，不能使用账户密码
# 获取方式：Google 账户 -> 安全 -> 两步验证 -> 应用密码
SMTP_PASSWORD=your-app-password
# 发件人邮箱
SMTP_FROM=noreply@edugenius.ai
# 发件人名称
SMTP_FROM_NAME=EduGenius
# 是否使用 TLS（加密连接）
SMTP_USE_TLS=true

# ========== 密码重置配置 ==========
# 密码重置令牌有效期（小时）
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# ========== 前端 URL ==========
# 前端地址（用于生成密码重置链接）
FRONTEND_URL=http://localhost:3000
